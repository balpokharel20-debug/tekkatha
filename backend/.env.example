HOST=127.0.0.1
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/tekkatha
MONGODB_DATABASE=tekkatha
PUBLIC_SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
NODE_ENV=development
# The assistant calls this fixed HTTPS service from the backend only.
AI_ENABLED=true
AI_BASE_URL=https://ai.shahnishant.com.np
AI_ALLOWED_HOST=ai.shahnishant.com.np
AI_MODEL=llama-3.2-3b
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_PRODUCTS=6
AI_MAX_TOKENS=700
# Optional: set these before setup to choose the first admin account.
# Otherwise setup generates a strong password and writes ignored local credentials.
# ADMIN_EMAIL=admin@tekkatha.local
# ADMIN_PASSWORD=
