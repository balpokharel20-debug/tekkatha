<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9">
  <xsl:output method="html" encoding="UTF-8" indent="yes"/>
  <xsl:template match="/">
    <html lang="en">
      <head>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Tekkatha XML Sitemap</title>
        <style>
          * { box-sizing: border-box; }
          body { margin: 0; background: #fff; color: #152033; font-family: Arial, Helvetica, sans-serif; line-height: 1.5; }
          .hero { background: #1357d6; color: #fff; padding: 32px max(24px, calc((100vw - 1440px) / 2)); }
          .hero h1 { margin: 0 0 22px; font-size: clamp(29px, 4vw, 38px); font-weight: 600; }
          .hero p { margin: 0; max-width: 1150px; font-size: 16px; }
          .hero a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
          main { width: min(1440px, calc(100% - 48px)); margin: 38px auto 70px; }
          .count { margin: 0 0 14px; color: #475569; }
          table { width: 100%; border-collapse: collapse; text-align: left; }
          th { padding: 15px 13px; background: #1357d6; color: #fff; font-size: 15px; }
          td { padding: 12px 13px; border-bottom: 1px solid #d9e0ea; font-size: 14px; overflow-wrap: anywhere; }
          tr:nth-child(even) td { background: #f7f9fc; }
          td a { color: #07517e; text-decoration: none; }
          td a:hover { text-decoration: underline; }
          th:last-child, td:last-child { width: 25%; white-space: nowrap; }
          @media (max-width: 600px) {
            .hero { padding: 26px 20px; }
            .hero p { font-size: 14px; }
            main { width: calc(100% - 28px); margin-top: 24px; }
            th, td { padding: 10px 8px; font-size: 12px; }
            th:last-child, td:last-child { width: 38%; white-space: normal; }
          }
        </style>
      </head>
      <body>
        <div class="hero">
          <h1>XML Sitemap</h1>
          <p>This XML sitemap is generated by Tekkatha. Search engines use it to discover and revisit our public pages, articles, and products. <a href="/sitemap">Browse the website sitemap</a>.</p>
        </div>
        <main>
          <xsl:choose>
            <xsl:when test="s:sitemapindex">
              <p class="count">This XML Sitemap Index contains <strong><xsl:value-of select="count(s:sitemapindex/s:sitemap)"/></strong> sitemaps.</p>
              <table>
                <thead><tr><th>Sitemap</th><th>Last Modified</th></tr></thead>
                <tbody>
                  <xsl:for-each select="s:sitemapindex/s:sitemap">
                    <tr><td><a href="{s:loc}"><xsl:value-of select="s:loc"/></a></td><td><xsl:choose><xsl:when test="s:lastmod"><xsl:value-of select="s:lastmod"/></xsl:when><xsl:otherwise>—</xsl:otherwise></xsl:choose></td></tr>
                  </xsl:for-each>
                </tbody>
              </table>
            </xsl:when>
            <xsl:otherwise>
              <p class="count">This XML Sitemap contains <strong><xsl:value-of select="count(s:urlset/s:url)"/></strong> URLs.</p>
              <table>
                <thead><tr><th>URL</th><th>Last Modified</th></tr></thead>
                <tbody>
                  <xsl:for-each select="s:urlset/s:url">
                    <tr><td><a href="{s:loc}"><xsl:value-of select="s:loc"/></a></td><td><xsl:choose><xsl:when test="s:lastmod"><xsl:value-of select="s:lastmod"/></xsl:when><xsl:otherwise>—</xsl:otherwise></xsl:choose></td></tr>
                  </xsl:for-each>
                </tbody>
              </table>
            </xsl:otherwise>
          </xsl:choose>
        </main>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>
