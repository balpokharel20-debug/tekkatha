# Replace these placeholders before deployment. Do not publish real credentials.
SITE_ORIGIN=https://www.example.com
CMS_ORIGIN=https://cms.example.com

# Use a dedicated application user and TLS. Percent-encode special characters in the username/password.
MONGODB_URI=mongodb+srv://tekkatha_app:REPLACE_WITH_URL_ENCODED_PASSWORD@cluster.example.mongodb.net/tekkatha?retryWrites=true&w=majority
MONGODB_DATABASE=tekkatha

TRUST_PROXY_HOPS=1
AI_ENABLED=true
AI_BASE_URL=https://ai.shahnishant.com.np
AI_ALLOWED_HOST=ai.shahnishant.com.np
AI_MODEL=llama-3.2-3b
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_PRODUCTS=6
AI_MAX_TOKENS=700
